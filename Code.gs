const SPREADSHEET_ID = "GANTI_DENGAN_ID_GOOGLE_SHEETS_ANDA";
const CARDS_SHEET = "Cards", TXNS_SHEET = "Transactions";
const CARD_HEADERS = ["id","name","number","phone","type","issuedAt","expiresAt","status","notes","createdAt"];
const TXN_HEADERS = ["id","cardId","cardName","cardNumber","amount","discount","total","method","notes","date","createdAt"];
function doGet(e){try{const ss=SpreadsheetApp.openById(SPREADSHEET_ID);ensure_(ss);return out_({ok:true,cards:read_(ss.getSheetByName(CARDS_SHEET)),transactions:read_(ss.getSheetByName(TXNS_SHEET))})}catch(err){return out_({ok:false,error:String(err)})}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(15000);const b=JSON.parse((e&&e.postData&&e.postData.contents)||"{}");if(b.action!=="syncAll")throw Error("Action tidak dikenal");const ss=SpreadsheetApp.openById(SPREADSHEET_ID);ensure_(ss);write_(ss.getSheetByName(CARDS_SHEET),b.cards||[],CARD_HEADERS);write_(ss.getSheetByName(TXNS_SHEET),b.transactions||[],TXN_HEADERS);return out_({ok:true})}catch(err){return out_({ok:false,error:String(err)})}finally{try{lock.releaseLock()}catch(_){}}}
function ensure_(ss){[[CARDS_SHEET,CARD_HEADERS],[TXNS_SHEET,TXN_HEADERS]].forEach(([n,h])=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(!s.getLastRow())s.appendRow(h);else if(s.getRange(1,1,1,h.length).getDisplayValues()[0].join("|")!==h.join("|"))s.getRange(1,1,1,h.length).setValues([h])})}
function read_(s){const a=s.getDataRange().getValues();if(a.length<2)return[];const h=a[0].map(String);return a.slice(1).filter(r=>r.some(v=>v!=="")).map(r=>{const o={};h.forEach((k,i)=>{let v=r[i];if(v instanceof Date)v=Utilities.formatDate(v,Session.getScriptTimeZone(),"yyyy-MM-dd'T'HH:mm:ss");o[k]=v});["amount","discount","total"].forEach(k=>{if(o[k]!==undefined&&o[k]!=="")o[k]=Number(o[k])});return o})}
function write_(s,rows,h){s.clearContents();s.getRange(1,1,1,h.length).setValues([h]);s.setFrozenRows(1);if(rows.length){s.getRange(2,1,rows.length,h.length).setValues(rows.map(o=>h.map(k=>o[k]==null?"":o[k])));s.autoResizeColumns(1,h.length)}}
function out_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
